    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/sosPhones"
        android:textSize="16dp"
        android:fontFamily="@font/assistantregular"
        android:layout_gravity="right"
        android:layout_marginLeft="180dp"
        android:layout_marginRight="30dp"
        android:layout_marginBottom="8dp" />

    <EditText
        android:id="@+id/updatePsos1"
        android:layout_width="360dp"
        android:layout_height="53dp"
        android:hint="@string/phone1sos"
        android:inputType="phone"
        android:digits="0123456789"
        android:maxLength="10"
        android:padding="16dp"
        android:textSize="18dp"
        android:scrollbars="none"
        android:gravity="right"
        android:fontFamily="@font/assistantregular"
        android:background="@drawable/rounded_input_background"
        android:layout_marginBottom="8dp"
        android:layout_gravity="center"/>

    <EditText
        android:id="@+id/updatePsos2"
        android:layout_width="360dp"
        android:layout_height="53dp"
        android:hint="@string/phone2sos"
        android:inputType="phone"
        android:digits="0123456789"
        android:maxLength="10"
        android:padding="16dp"
        android:textSize="18dp"
        android:gravity="right"
        android:scrollbars="none"
        android:fontFamily="@font/assistantregular"
        android:background="@drawable/rounded_input_background"
        android:layout_marginBottom="8dp"
        android:layout_gravity="center"/>

    <EditText
        android:id="@+id/updatePsos3"
        android:layout_width="360dp"
        android:layout_height="53dp"
        android:hint="@string/phone3sos"
        android:inputType="phone"
        android:digits="0123456789"
        android:maxLength="10"
        android:padding="16dp"
        android:textSize="18dp"
        android:scrollbars="none"
        android:gravity="right"
        android:fontFamily="@font/assistantregular"
        android:background="@drawable/rounded_input_background"
        android:layout_marginBottom="8dp"
        android:layout_gravity="center"/>

        </LinearLayout>
    </ScrollView>

    <Button
        android:id="@+id/btnNext"
        android:layout_width="360dp"
        android:layout_height="53dp"
        android:text="@string/save"
        android:textColor="#8257E3"
        android:background="?android:attr/selectableItemBackground"
        android:foreground="@drawable/backgroundbtn2"
        android:fontFamily="@font/assistantregular"
        android:textSize="17dp"
        android:layout_gravity="center"
        android:focusable="true"
        android:layout_marginBottom="25dp"
        android:layout_marginTop="8dp"/>





