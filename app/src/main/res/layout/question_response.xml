<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:ndroid="http://schemas.android.com/apk/res-auto"
    xmlns:gdp="http://schemas.android.com/tools"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/requestLL"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal"
        android:visibility="gone"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/requestIcon"
            android:layout_width="45dp"
            android:layout_height="45dp"
            android:layout_marginRight="2dp"
             android:src="@drawable/logoblack"/>

        <TextView
            android:id="@+id/request"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/rounded_input_background"
            android:fontFamily="@font/assistantregular"
            android:layout_marginLeft="10dp"
            android:textSize="18dp"
            android:padding="10dp"/>

    </LinearLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal"
        >

        <ImageView
            android:id="@+id/responseIcon"
            android:layout_width="45dp"
            android:layout_height="45dp"
            android:layout_marginRight="2dp"
            android:visibility="gone"
            android:src="@drawable/newlogo" />

        <TextView
            android:id="@+id/response"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="18dp"
            android:layout_marginRight="1dp"
            android:layout_marginLeft="10dp"
            android:text="@string/typing"
            android:visibility="gone"
            android:fontFamily="@font/assistantregular"
            android:textColor="@color/black"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="10dp"/>

    </LinearLayout>

    <LinearLayout
        android:id="@+id/responseBtns"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_gravity="right"
        android:visibility="gone"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="10dp"
        android:layout_marginRight="35dp">


        <ImageButton
            android:id="@+id/helplinesBtn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            ndroid:background="@android:color/transparent"
            android:background="?android:attr/selectableItemBackground"
            android:layout_marginStart="13dp"
            android:focusable="true"
            android:src="@drawable/helplinesbtn"/>

        <ImageButton
            android:id="@+id/copyBtn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            ndroid:background="@android:color/transparent"
            android:background="?android:attr/selectableItemBackground"
            android:layout_marginStart="13dp"
            android:focusable="true"
            android:src="@drawable/copy"/>

        <ImageButton
            android:id="@+id/readMe"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            ndroid:background="@android:color/transparent"
            android:background="?android:attr/selectableItemBackground"
            android:layout_marginStart="13dp"
            android:focusable="true"
            android:src="@drawable/volume"/>

    </LinearLayout>

</LinearLayout>